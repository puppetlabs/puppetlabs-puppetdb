{
  "name": "puppetlabs-puppetdb",
  "version": "9.0.0",
  "author": "puppetlabs",
  "summary": "Installs PostgreSQL and PuppetDB, sets up the connection to Puppet master.",
  "license": "Apache-2.0",
  "source": "https://github.com/puppetlabs/puppetlabs-puppetdb.git",
  "project_page": "http://github.com/puppetlabs/puppetlabs-puppetdb",
  "issues_url": "https://tickets.puppetlabs.com/browse/PDB",
  "dependencies": [
    {
      "name": "puppetlabs/inifile",
      "version_requirement": ">= 6.0.0 < 7.0.0"
    },
    {
      "name": "puppetlabs/postgresql",
      "version_requirement": ">= 10.0.0 < 11.0.0"
    },
    {
      "name": "puppetlabs/firewall",
      "version_requirement": ">= 8.0.0 < 9.0.0"
    },
    {
      "name": "puppetlabs/stdlib",
      "version_requirement": ">= 9.0.0 < 10.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "RedHat",
      "operatingsystemrelease": [
        "8",
        "9",
        "10"
      ]
    },
    {
      "operatingsystem": "SLES",
      "operatingsystemrelease": [
        "12 SP1",
        "15"
      ]
    },
    {
      "operatingsystem": "Debian",
      "operatingsystemrelease": [
        "13"
      ]
    },
    {
      "operatingsystem": "Ubuntu",
      "operatingsystemrelease": [
        "22.04",
        "24.04"
      ]
    }
  ],
  "requirements": [
    {
      "name": "puppet",
      "version_requirement": ">= 8.0.0 < 10.0.0"
    }
  ],
  "pdk-version": "3.8.0",
  "template-url": "https://github.com/puppetlabs/pdk-templates#3.8.0",
  "template-ref": "tags/3.8.0-0-gf1124a6"
}
